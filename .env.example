# --- Discord ---
# Same bot token is used by both this bot and discord-mcp (they act as the same bot user).
DISCORD_TOKEN=your-bot-token
# Optional default guild for discord-mcp (the bot always injects the current server anyway)
DISCORD_GUILD_ID=

# --- discord-mcp (HTTP streamable endpoint) ---
MCP_URL=http://localhost:8085/mcp

# --- Extra MCP servers (see mcp_servers.json; ${VAR}s there come from this file) ---
# SearXNG instance for web search (needs the JSON format enabled). Leave empty to disable.
SEARXNG_URL=
# MCP_SERVERS_FILE=mcp_servers.json

# --- Qwen via any OpenAI-compatible API ---
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:14b
# vLLM:      LLM_BASE_URL=http://localhost:8000/v1    LLM_MODEL=Qwen/Qwen3-32B   (run with --enable-auto-tool-choice --tool-call-parser hermes)
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1
# DashScope: LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.6
# Extra JSON passed to the API, e.g. {"enable_thinking": false} for DashScope/vLLM Qwen3
LLM_EXTRA_BODY={}
# Set true if your model accepts images (e.g. qwen2.5-vl / qwen3-vl)
VISION=false

# --- Behaviour ---
MAX_TOOL_ROUNDS=12
HISTORY_LIMIT=20
TOOL_RESULT_MAX_CHARS=6000
TOOL_TIMEOUT=60
USER_COOLDOWN=3
SHOW_TOOL_TRACE=true
# Enable only if "Server Members Intent" is on in the developer portal (better hierarchy checks)
MEMBERS_INTENT=false

# --- Access control ---
# Comma-separated user IDs that bypass all permission checks (you)
OWNER_IDS=
# If set, only members with one of these role IDs can use the bot
ALLOWED_ROLE_IDS=
# Comma-separated tool names to hide from the agent entirely, e.g. ban_member,delete_channel
DISABLED_TOOLS=read_private_messages
